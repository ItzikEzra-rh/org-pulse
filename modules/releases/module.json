{
  "name": "Releases",
  "slug": "releases",
  "defaultEnabled": true,
  "description": "Unified release lifecycle: planning, execution tracking, and delivery readiness",
  "icon": "rocket",
  "order": 3,
  "client": {
    "entry": "./client/index.js",
    "navItems": [
      { "id": "schedule", "label": "Schedule", "icon": "CalendarDays" },
      { "id": "execute", "label": "Execute", "icon": "GitBranch", "default": true },
      { "id": "deliver", "label": "Deliver", "icon": "Rocket", "disabled": true },
      { "id": "jira-hygiene", "label": "Jira Hygiene", "icon": "BarChart3" },
      { "id": "release-plan", "label": "Release Plan", "icon": "Map" }
    ],
    "sotuWidgets": [
      {
        "id": "schedule",
        "name": "Release Schedule",
        "description": "Upcoming release milestones with countdowns",
        "component": "./client/widgets/ScheduleWidget.vue",
        "defaultSize": "half",
        "icon": "CalendarDays",
        "category": "releases"
      }
    ],
    "settingsComponent": "./client/components/ReleasesSettings.vue",
    "hiddenRoutes": {
      "feature-detail": "execute"
    }
  },
  "server": {
    "entry": "./server/index.js"
  },
  "secrets": {
    "platform": ["jira"],
    "module": [
      {
        "key": "PRODUCT_PAGES_CLIENT_ID",
        "description": "OAuth client ID for Product Pages (production)",
        "required": false,
        "group": "product-pages-auth"
      },
      {
        "key": "PRODUCT_PAGES_CLIENT_SECRET",
        "description": "OAuth client secret for Product Pages",
        "required": false,
        "group": "product-pages-auth"
      },
      {
        "key": "PRODUCT_PAGES_TOKEN",
        "description": "Personal bearer token for Product Pages (local dev fallback)",
        "required": false,
        "group": "product-pages-auth",
        "exclusive": true
      },
      {
        "key": "FEATURE_TRAFFIC_GITLAB_TOKEN",
        "description": "GitLab PAT for CI artifact fetching (overrides GITLAB_TOKEN)",
        "required": false
      },
      {
        "key": "SMARTSHEET_API_TOKEN",
        "description": "SmartSheet API token for release discovery",
        "required": false
      }
    ]
  },
  "export": {
    "files": [
      { "path": "releases/registry.json", "notes": "Canonical release registry" },
      { "path": "releases/execution/index.json", "notes": "Feature index with summary metrics" },
      { "path": "releases/execution/features/*.json", "notes": "Per-feature detail files" },
      { "path": "projects/index.json", "notes": "Published project index for qualified Execute data" },
      { "path": "projects/*/profile.json", "notes": "Project profile used by qualified Execute data" },
      { "path": "projects/*/current.json", "notes": "Pinned project publication generation" },
      { "path": "projects/*/generations/*/profile.json", "notes": "Project profile in an immutable publication generation" },
      { "path": "projects/*/generations/*/releases/registry.json", "notes": "Project-qualified release registry" },
      { "path": "projects/*/generations/*/releases/execution/index.json", "notes": "Project-qualified Execute feature index" },
      { "path": "projects/*/generations/*/releases/execution/features/*.json", "notes": "Project-qualified Execute feature details" },
      { "path": "projects/*/generations/*/releases/execution/tracking-data-*.json", "notes": "Project-qualified release tracking details" },
      { "path": "projects/*/releases/registry.json", "notes": "Project-qualified release registry in direct data-repo mode" },
      { "path": "projects/*/releases/execution/index.json", "notes": "Project-qualified Execute feature index in direct data-repo mode" },
      { "path": "projects/*/releases/execution/features/*.json", "notes": "Project-qualified Execute details in direct data-repo mode" },
      { "path": "projects/*/releases/execution/tracking-data-*.json", "notes": "Project-qualified release tracking details in direct data-repo mode" }
    ]
  }
}
